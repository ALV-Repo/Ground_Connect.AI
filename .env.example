APP_NAME=GroundConnect AI
APP_VERSION=1.0.0
DEBUG=true

# Current implementation uses mock/fallback.
AI_PROVIDER=mock

# Launch languages
SUPPORTED_LANGUAGES=en,hi,kn

# Default speech language
DEFAULT_LANGUAGE=hi-IN

# Below this confidence human confirmation is required
TRANSCRIPTION_CONFIDENCE_THRESHOLD=0.80

# No external AI API key is required.
# OPENAI_API_KEY=